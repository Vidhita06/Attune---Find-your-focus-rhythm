package com.attune.app.ui.queue
import androidx.lifecycle.ViewModel; import androidx.lifecycle.viewModelScope
import com.attune.core.data.db.dao.QueuedNotificationDao; import dagger.hilt.android.lifecycle.HiltViewModel
import kotlinx.coroutines.flow.*; import javax.inject.Inject
@HiltViewModel class QueueViewModel @Inject constructor(private val dao:QueuedNotificationDao):ViewModel(){
    val pending:StateFlow<List<com.attune.core.model.QueuedNotification>>=dao.observePending().stateIn(viewModelScope,SharingStarted.WhileSubscribed(5000), emptyList())
}