<?xml version="1.0" encoding="utf-8"?>
<!-- Android 6–11 full-backup rules (android:fullBackupContent). Nothing is included. -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
