<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+). Attune keeps nothing in cloud backup or device-to-device transfer: queue text, decisions,
     learned preferences, rules and settings stay on the device. Every domain is excluded explicitly (not only the database),
     so adding a new file or preference store later cannot leak by default. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
